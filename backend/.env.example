# Anthropic API key (required for full Claude-generated answers; omit to run in demo mode)
ANTHROPIC_API_KEY=your_api_key_here

# Models (see https://docs.anthropic.com for current model IDs)
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_REWRITE_MODEL=claude-haiku-4-5

# Document processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=10
MAX_DOCUMENTS_PER_SESSION=50
MAX_TOTAL_UPLOAD_MB_PER_SESSION=100

# Storage
UPLOAD_DIR=./uploads
VECTOR_DB_PATH=./vector_db

# Built frontend (`cd frontend && npm run build`) - served directly by this
# app when present. Leave unset/default if you're only running the API
# (e.g. against the separate Vite dev server) or haven't built it yet.
# FRONTEND_DIST_PATH=../frontend/dist

# Best-effort per-process request limits (see app/core/rate_limit.py)
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# Only needed for local development against the separate Vite dev server
# (`npm run dev`, default port 5173). In production the frontend is built
# and served by this same FastAPI app (same-origin), so CORS isn't
# exercised at all - leave this unset/empty in production.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# `Secure` cookies are only ever sent over HTTPS - real browsers do NOT
# make an exception for localhost/127.0.0.1 over plain HTTP (verified
# against Chromium while building this). Leave false for local dev/demo
# use; set to true once this is actually deployed behind HTTPS, or the
# secure flag will silently break the session cookie there instead.
COOKIE_SECURE=false

LOG_LEVEL=INFO
